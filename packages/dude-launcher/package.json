{
  "name": "@cubocicloide/dude-launcher",
  "version": "0.3.0",
  "description": "Tiny global launcher for dude — resolves and runs each project's pinned CLI + stack.",
  "type": "module",
  "bin": {
    "dude": "./bin/dude.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "lint": "echo \"(lint placeholder — to be configured)\"",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsup": "^8.3.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
