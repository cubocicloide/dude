{
  "schema": "dude.stack/1",
  "id": "airflow",
  "package": "@cubocicloide/stack-airflow",
  "description": "An Apache Airflow project — organized DAGs & plugins, native or Entra ID SSO, optional AWS ECS Fargate IaC.",
  "tagline": "An Apache Airflow project — organized DAGs & plugins, native or Entra ID SSO, optional AWS ECS Fargate IaC.",
  "technologies": [
    "Apache Airflow 3",
    "PostgreSQL"
  ],
  "useCases": [
    "A team orchestrating scheduled data pipelines (DAGs) with a clear, lint-enforced structure",
    "Enterprise sign-on via Microsoft Entra ID OAuth (or Airflow's native auth) for the web UI",
    "Bursty, heavy tasks that need their own container via the hybrid AWS ECS executor, without a full Kubernetes cluster"
  ],
  "requiresDude": "0.1.0",
  "iac": {
    "provider": "aws-ecs",
    "flag": "--iac aws-ecs"
  },
  "init": {
    "command": "dude init my-app --stack airflow",
    "variables": [
      {
        "name": "projectName",
        "flag": "--project-name",
        "type": "string",
        "prompt": "Project name",
        "default": "my-airflow",
        "choices": null
      },
      {
        "name": "sso",
        "flag": "--sso",
        "type": "select",
        "prompt": "Web UI sign-on (native = Airflow user database, entra-id = Microsoft Entra ID OAuth)",
        "default": "native",
        "choices": [
          "native",
          "entra-id"
        ]
      },
      {
        "name": "iac",
        "flag": "--iac",
        "type": "select",
        "prompt": "Infrastructure-as-Code (Terraform, AWS ECS Fargate + ECS executor)",
        "default": "none",
        "choices": [
          "none",
          "aws-ecs"
        ]
      }
    ],
    "flagsAreCaseAndDashInsensitive": true
  },
  "lint": {
    "groups": [
      {
        "group": "AF",
        "checks": 10
      }
    ],
    "totalChecks": 10,
    "rulePathTemplate": ".claude/rules/<GROUP>/<NNN>.md"
  },
  "docsPages": [
    {
      "file": "index.md",
      "title": "Home"
    },
    {
      "file": "dude.md",
      "title": "Working with dude"
    },
    {
      "file": "project.md",
      "title": "Project guide"
    },
    {
      "file": "sso.md",
      "title": "Sign-on (SSO)"
    },
    {
      "file": "deploy.md",
      "title": "Deploy (AWS ECS)",
      "when": "withIac"
    },
    {
      "file": "api.md",
      "title": "Command reference"
    },
    {
      "file": "cheatsheet.md",
      "title": "Cheatsheet"
    },
    {
      "file": "mkdocs.md",
      "title": "Writing docs"
    }
  ],
  "cheatsheet": "dude cheatsheet --format json"
}
