{
  "schema": "dude.stack/1",
  "id": "expo-firebase",
  "package": "@cubocicloide/stack-expo-firebase",
  "description": "A universal Expo app with Firebase Authentication and Firestore.",
  "tagline": "A universal Expo app for Android, iOS and web with Firebase Auth and Firestore.",
  "technologies": [
    "Expo SDK 57",
    "React Native 0.86",
    "Expo Router",
    "Firebase 12"
  ],
  "useCases": [
    "A universal Android, iOS and web product built from one React Native codebase",
    "An Expo Go-friendly app with Firebase email/password authentication and Firestore",
    "A mobile team that wants local Firebase emulators and EAS build profiles from day one"
  ],
  "requiresDude": "0.17.2",
  "iac": null,
  "init": {
    "command": "dude init my-app --stack expo-firebase",
    "variables": [
      {
        "name": "projectName",
        "flag": "--project-name",
        "type": "string",
        "prompt": "Project name",
        "default": "my-app",
        "choices": null
      }
    ],
    "flagsAreCaseAndDashInsensitive": true
  },
  "lint": {
    "groups": [
      {
        "group": "FB",
        "checks": 4
      },
      {
        "group": "RN",
        "checks": 6
      }
    ],
    "totalChecks": 10,
    "rulePathTemplate": ".claude/rules/<GROUP>/<NNN>.md"
  },
  "docsPages": [
    {
      "file": "index.md",
      "title": "Home"
    },
    {
      "file": "architecture.md",
      "title": "Architecture"
    },
    {
      "file": "firebase.md",
      "title": "Firebase setup"
    },
    {
      "file": "emulators.md",
      "title": "Local emulators"
    },
    {
      "file": "testing.md",
      "title": "Testing"
    },
    {
      "file": "builds.md",
      "title": "EAS builds"
    },
    {
      "file": "dude.md",
      "title": "Working with dude"
    },
    {
      "file": "api.md",
      "title": "Command reference"
    },
    {
      "file": "cheatsheet.md",
      "title": "Cheatsheet"
    },
    {
      "file": "mkdocs.md",
      "title": "Writing docs"
    }
  ],
  "cheatsheet": "dude cheatsheet --format json"
}
