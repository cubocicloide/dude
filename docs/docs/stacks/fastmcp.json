{
  "schema": "dude.stack/1",
  "id": "fastmcp",
  "package": "@cubocicloide/stack-fastmcp",
  "description": "A FastMCP (Python) server — modular monolith of MCP feature sub-servers.",
  "tagline": "A FastMCP (Python) server — modular MCP feature sub-servers, with optional AWS ECS Fargate IaC.",
  "technologies": [
    "FastMCP",
    "Python",
    "Pydantic"
  ],
  "useCases": [
    "An MCP server exposing tools/resources to LLM clients over a typed Python API",
    "A modular monolith of MCP feature sub-servers that can grow independently",
    "A lightweight service that ships to AWS ECS Fargate without a Kubernetes footprint"
  ],
  "requiresDude": "0.1.0",
  "iac": {
    "provider": "aws-ecs",
    "flag": "--iac aws-ecs"
  },
  "init": {
    "command": "dude init my-app --stack fastmcp",
    "variables": [
      {
        "name": "projectName",
        "flag": "--project-name",
        "type": "string",
        "prompt": "Project name",
        "default": "my-mcp",
        "choices": null
      },
      {
        "name": "iac",
        "flag": "--iac",
        "type": "select",
        "prompt": "Infrastructure-as-Code (Terraform, AWS ECS Fargate)",
        "default": "none",
        "choices": [
          "none",
          "aws-ecs"
        ]
      }
    ],
    "flagsAreCaseAndDashInsensitive": true
  },
  "lint": {
    "groups": [
      {
        "group": "MCP",
        "checks": 17
      }
    ],
    "totalChecks": 17,
    "rulePathTemplate": ".claude/rules/<GROUP>/<NNN>.md"
  },
  "docsPages": [
    {
      "file": "index.md",
      "title": "Home"
    },
    {
      "file": "dude.md",
      "title": "Working with dude"
    },
    {
      "file": "connect.md",
      "title": "Connecting a client"
    },
    {
      "file": "architecture.md",
      "title": "Architecture"
    },
    {
      "file": "deploy.md",
      "title": "Deploy (AWS ECS)",
      "when": "withIac"
    },
    {
      "file": "api.md",
      "title": "Command reference"
    },
    {
      "file": "cheatsheet.md",
      "title": "Cheatsheet"
    },
    {
      "file": "mkdocs.md",
      "title": "Writing docs"
    }
  ],
  "cheatsheet": "dude cheatsheet --format json"
}
