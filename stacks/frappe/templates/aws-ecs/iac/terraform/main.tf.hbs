# ── One-off task definitions ─────────────────────────────────────────────────
# Run by the CLI with `aws ecs run-task` — never as long-lived services.

# configurator: points the bench at RDS/ElastiCache by writing
# common_site_config.json on the sites volume, and refreshes the built assets
# from the copy baked into the image (sites/ shadows the image's own assets).
resource "aws_ecs_task_definition" "configurator" {
  family                   = "${local.name}-configurator"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = 256
  memory                   = 512
  execution_role_arn       = aws_iam_role.execution.arn
  task_role_arn            = aws_iam_role.task.arn

  volume {
    name = local.sites_volume.name

    efs_volume_configuration {
      file_system_id     = local.sites_volume.efs_volume_configuration.file_system_id
      transit_encryption = local.sites_volume.efs_volume_configuration.transit_encryption

      authorization_config {
        access_point_id = local.sites_volume.efs_volume_configuration.authorization_config.access_point_id
        iam             = local.sites_volume.efs_volume_configuration.authorization_config.iam
      }
    }
  }

  container_definitions = jsonencode([
    {
      name      = "configurator"
      image     = local.image
      essential = true
      command = ["bash", "-c", join("; ", [
        "set -e",
        "ls -1 apps > sites/apps.txt",
        "bench set-config -g db_host \"$DB_HOST\"",
        "bench set-config -gp db_port 3306",
        "bench set-config -g redis_cache \"$REDIS_CACHE\"",
        "bench set-config -g redis_queue \"$REDIS_QUEUE\"",
        "bench set-config -g redis_socketio \"$REDIS_SOCKETIO\"",
        "bench set-config -gp socketio_port ${local.websocket_port}",
        "mkdir -p sites/assets",
        "cp -rf ${local.bench_dir}/assets-baked/. sites/assets/ 2>/dev/null || true",
        "echo configurator done",
      ])]

      environment = [
        { name = "DB_HOST", value = aws_db_instance.this.address },
        { name = "REDIS_CACHE", value = local.redis_cache },
        { name = "REDIS_QUEUE", value = local.redis_queue },
        { name = "REDIS_SOCKETIO", value = local.redis_socketio },
      ]

      mountPoints = local.sites_mount
      logConfiguration = merge(local.log_configuration["backend"], {
        options = merge(local.log_configuration["backend"].options, { awslogs-stream-prefix = "configurator" })
      })
    }
  ])
}

# create-site: first-deploy only. Idempotent — exits 0 when the site exists.
resource "aws_ecs_task_definition" "create_site" {
  family                   = "${local.name}-create-site"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = var.backend_cpu
  memory                   = var.backend_memory
  execution_role_arn       = aws_iam_role.execution.arn
  task_role_arn            = aws_iam_role.task.arn

  volume {
    name = local.sites_volume.name

    efs_volume_configuration {
      file_system_id     = local.sites_volume.efs_volume_configuration.file_system_id
      transit_encryption = local.sites_volume.efs_volume_configuration.transit_encryption

      authorization_config {
        access_point_id = local.sites_volume.efs_volume_configuration.authorization_config.access_point_id
        iam             = local.sites_volume.efs_volume_configuration.authorization_config.iam
      }
    }
  }

  container_definitions = jsonencode([
    {
      name      = "create-site"
      image     = local.image
      essential = true
      command = ["bash", "-c", join("; ", [
        "set -e",
        "if [ -d \"sites/$SITE_NAME\" ]; then echo \"site $SITE_NAME already exists\"; exit 0; fi",
        join(" ", [
          "bench new-site \"$SITE_NAME\"",
          "--no-mariadb-socket",
          "--mariadb-root-username admin",
          "--mariadb-root-password \"$DB_ROOT_PASSWORD\"",
          "--admin-password \"$ADMIN_PASSWORD\"",
{{#if withHelpdesk}}
          "--install-app helpdesk",
{{/if}}
          "--install-app ticketing",
          "--set-default",
        ]),
        # RDS: frappe must not attempt grants that need SUPER privileges.
        "bench --site \"$SITE_NAME\" set-config rds_db 1",
        "echo site created",
      ])]

      environment = [
        { name = "SITE_NAME", value = local.site_name },
      ]

      secrets = [
        { name = "DB_ROOT_PASSWORD", valueFrom = aws_secretsmanager_secret.db_root_password.arn },
        { name = "ADMIN_PASSWORD", valueFrom = aws_secretsmanager_secret.admin_password.arn },
      ]

      mountPoints = local.sites_mount
      logConfiguration = merge(local.log_configuration["backend"], {
        options = merge(local.log_configuration["backend"].options, { awslogs-stream-prefix = "create-site" })
      })
    }
  ])
}

# migrate: after every deploy that changes DocTypes/patches/fixtures. Also
# refreshes the baked assets, so a plain `ship + migrate` cycle is complete.
resource "aws_ecs_task_definition" "migrate" {
  family                   = "${local.name}-migrate"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = var.backend_cpu
  memory                   = var.backend_memory
  execution_role_arn       = aws_iam_role.execution.arn
  task_role_arn            = aws_iam_role.task.arn

  volume {
    name = local.sites_volume.name

    efs_volume_configuration {
      file_system_id     = local.sites_volume.efs_volume_configuration.file_system_id
      transit_encryption = local.sites_volume.efs_volume_configuration.transit_encryption

      authorization_config {
        access_point_id = local.sites_volume.efs_volume_configuration.authorization_config.access_point_id
        iam             = local.sites_volume.efs_volume_configuration.authorization_config.iam
      }
    }
  }

  container_definitions = jsonencode([
    {
      name      = "migrate"
      image     = local.image
      essential = true
      command = ["bash", "-c", join("; ", [
        "set -e",
        "cp -rf ${local.bench_dir}/assets-baked/. sites/assets/ 2>/dev/null || true",
