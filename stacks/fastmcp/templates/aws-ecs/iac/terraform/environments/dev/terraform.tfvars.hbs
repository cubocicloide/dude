# dev environment — small, cost-conscious defaults.
# Copy this folder to add a new environment (e.g. environments/prod) and bump
# the sizing / durability knobs there.

environment = "dev"
region      = "eu-west-1"

# The image tag currently deployed. `dude iac deploy` (and `ship`) rewrite this
# line, so a plain `dude iac apply` always re-deploys the same build.
image_tag = "latest"

# Fargate sizing. NOTE on desired_count: MCP sessions live in a task's memory,
# so with more than one task a client's requests can land on a task that does
# not know its session — keep 1 unless the server runs in stateless mode.
task_cpu      = 256
task_memory   = 512
desired_count = 1

# Who may reach the server. The scaffolded MCP server ships with NO
# authentication — restrict this to your org's networks (or add auth) before
# widening it.
allowed_cidrs = ["0.0.0.0/0"]

# TLS + DNS (optional) — uncomment and set to serve HTTPS on your own domain.
# The hosted zone must already exist in Route53. Terraform then issues an ACM
# certificate (DNS-validated), points the domain at the ALB, and the ALB
# listens on 443 redirecting HTTP→HTTPS. Leave commented for plain HTTP.
# domain_name       = "mcp.example.com"
# route53_zone_name = "example.com"
