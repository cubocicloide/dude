# ── Identity ──────────────────────────────────────────────────────────────────
variable "project_name" {
  description = "Project slug, used to name and tag every resource."
  type        = string
  default     = "{{projectName}}"
}

variable "environment" {
  description = "Environment name (dev, staging, prod, …). Drives naming + state key."
  type        = string
}

variable "location" {
  description = "Azure region to deploy into."
  type        = string
  default     = "westeurope"
}

variable "subscription_id" {
  description = "Azure subscription this environment lives in. Empty = whatever ARM_SUBSCRIPTION_ID / your az default resolves to."
  type        = string
  default     = ""
}

# ── Shared registry (created by the bootstrap; written here by `dude iac bootstrap`) ──
variable "acr_name" {
  description = "Name of the shared container registry created by the bootstrap."
  type        = string
}

variable "acr_resource_group" {
  description = "Resource group holding the shared container registry (the bootstrap's group)."
  type        = string
}

# ── Network ───────────────────────────────────────────────────────────────────
variable "vnet_cidr" {
  description = "Address space for the virtual network."
  type        = string
  default     = "10.0.0.0/16"
}

variable "aks_subnet_cidr" {
  description = "Subnet hosting the AKS node pool."
  type        = string
  default     = "10.0.0.0/20"
}
{{#if withPostgres}}

variable "db_subnet_cidr" {
  description = "Subnet delegated to the PostgreSQL Flexible Server (must not overlap the AKS subnet)."
  type        = string
  default     = "10.0.16.0/24"
}
{{/if}}

# ── AKS ───────────────────────────────────────────────────────────────────────
variable "kubernetes_version" {
  description = "Kubernetes version for the AKS control plane. Empty = whatever Azure defaults to in this region (always a supported version)."
  type        = string
  default     = ""
}

variable "node_vm_size" {
  description = "VM size for the default node pool."
  type        = string
  default     = "Standard_D2as_v5"
}

variable "node_min_count" {
  description = "Minimum number of worker nodes (autoscaler lower bound)."
  type        = number
  default     = 2
}

variable "node_max_count" {
  description = "Maximum number of worker nodes (autoscaler upper bound)."
  type        = number
  default     = 4
}

variable "node_count" {
  description = "Initial number of worker nodes."
  type        = number
  default     = 2
}

# ── Public hostname ───────────────────────────────────────────────────────────
variable "dns_label" {
  description = "DNS label for the ingress public IP. Azure serves the app at <dns_label>.<location>.cloudapp.azure.com. Must be unique within the region. Empty = <project>-<environment>."
  type        = string
  default     = ""
}

variable "ingress_nginx_chart_version" {
  description = "Chart version for ingress-nginx (the in-cluster ingress controller)."
  type        = string
  default     = "4.11.3"
}

# ── TLS (optional — needs a domain you own) ───────────────────────────────────
variable "letsencrypt_email" {
  description = "Contact address for Let's Encrypt. Set this ONLY once a domain you own points at the ingress: Azure's own *.cloudapp.azure.com name cannot get a trusted certificate (see iac/README.md). Empty = no cert-manager, plain HTTP."
  type        = string
  default     = ""
}

variable "cert_manager_chart_version" {
  description = "Chart version for cert-manager."
  type        = string
  default     = "v1.16.2"
}
{{#if withPostgres}}

# ── Azure Database for PostgreSQL (Flexible Server) ───────────────────────────
variable "db_version" {
  description = "PostgreSQL major version."
  type        = string
  default     = "16"
}

variable "db_sku_name" {
  description = "Flexible Server SKU (e.g. B_Standard_B1ms for dev, GP_Standard_D2ds_v4 for prod)."
  type        = string
  default     = "B_Standard_B1ms"
}

variable "db_storage_mb" {
  description = "Allocated storage in MB (minimum 32768)."
  type        = number
  default     = 32768
}

variable "db_name" {
  description = "Initial database name."
  type        = string
  default     = "app"
}

variable "db_username" {
  description = "Administrator username. The password is generated by Terraform and surfaced through the sensitive `database_url` output."
  type        = string
  default     = "appadmin"
}

variable "db_backup_retention_days" {
  description = "Days of automated backups to retain (7–35)."
  type        = number
  default     = 7
}

variable "db_high_availability" {
  description = "Run the database zone-redundant (recommended for prod; not available on Burstable SKUs)."
  type        = bool
  default     = false
}
{{/if}}
