# SPA routing + API proxy.
#
# On Container Apps there is no shared ingress doing path-based routing: the
# frontend is the one externally reachable app, so it proxies /api to the
# backend itself. BACKEND_URL is injected by Terraform as an environment
# variable and substituted into this file at container start — the stock nginx
# entrypoint runs envsubst over /etc/nginx/templates/*.template. Only real
# environment variables are substituted, so nginx's own $uri/$host survive.
server {
    # 8080, not 80: the image runs unprivileged and cannot bind a port < 1024.
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # The external edge terminates TLS, so the backend must be told the
        # original scheme or it will build http:// links in redirects and in the
        # OpenAPI server URL.
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 120s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Long-cache hashed assets.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
