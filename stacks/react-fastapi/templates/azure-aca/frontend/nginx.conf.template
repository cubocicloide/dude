# SPA routing + API proxy.
#
# On Container Apps there is no shared ingress doing path-based routing: the
# frontend is the one externally reachable app, so it proxies /api to the
# backend itself. BACKEND_URL is injected by Terraform as an environment
# variable and substituted into this file at container start — the stock nginx
# entrypoint runs envsubst over /etc/nginx/templates/*.template. Only real
# environment variables are substituted, so nginx's own $uri/$host survive.
server {
    # 8080, not 80: the image runs unprivileged and cannot bind a port < 1024.
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;

        # Host MUST stay the upstream's own hostname ($proxy_host, nginx's
        # default). Container Apps routes internal traffic by Host header, so
        # forwarding the browser's Host here makes the platform unable to tell
        # which app the request is for and answer 404 from its own edge — which
        # looks exactly like a missing route in the backend.
        proxy_set_header Host              $proxy_host;

        # The original host and scheme travel in the X-Forwarded-* headers
        # instead; the external edge terminates TLS, so without X-Forwarded-Proto
        # the backend builds http:// links in redirects and in the OpenAPI
        # server URL.
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Long-cache hashed assets.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
