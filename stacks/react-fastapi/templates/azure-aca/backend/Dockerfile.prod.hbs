# Production image for the backend: no --reload, no dev dependencies, app code
# baked in (no bind mounts in Kubernetes). Migrations run as a Helm pre-upgrade
# Job (`alembic upgrade head`), not on container start.
#
#   docker build -f Dockerfile.prod -t <ecr>/<proj>-backend:<tag> .

FROM python:3.13-slim
WORKDIR /app

RUN pip install --no-cache-dir uv

# Run as an unprivileged user (trivy DS002). The user is created *before* the
# virtualenv is built so every layer is written with the right ownership — a
# trailing `chown -R /app` would instead duplicate the whole .venv into an
# extra layer.
RUN useradd -m -u 1000 appuser && chown appuser:appuser /app
USER appuser

COPY --chown=appuser:appuser pyproject.toml .
RUN uv sync --no-cache --no-dev

COPY --chown=appuser:appuser app ./app
{{#if withPostgres}}
COPY --chown=appuser:appuser alembic ./alembic
COPY --chown=appuser:appuser alembic.ini ./alembic.ini
{{/if}}

EXPOSE 8000
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
