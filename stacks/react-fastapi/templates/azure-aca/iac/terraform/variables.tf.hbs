# ── Identity ──────────────────────────────────────────────────────────────────
variable "project_name" {
  description = "Project slug, used to name and tag every resource."
  type        = string
  default     = "{{projectName}}"
}

variable "environment" {
  description = "Environment name (dev, staging, prod, …). Drives naming + state key."
  type        = string
}

variable "location" {
  description = "Azure region to deploy into. North Europe is the default because several popular regions — West Europe among them — are capacity-closed to new subscriptions and reject resource creation with RequestDisallowedByAzure."
  type        = string
  default     = "northeurope"
}

variable "subscription_id" {
  description = "Azure subscription this environment lives in. Empty = whatever ARM_SUBSCRIPTION_ID / your az default resolves to."
  type        = string
  default     = ""
}

# ── Shared registry (created by the bootstrap; written here by `dude iac bootstrap`) ──
variable "acr_name" {
  description = "Name of the shared container registry created by the bootstrap."
  type        = string
}

variable "acr_resource_group" {
  description = "Resource group holding the shared container registry (the bootstrap's group)."
  type        = string
}

variable "image_tag" {
  description = "Image tag every container app runs. `dude iac deploy`/`ship` rewrites this, so it is the committed record of what is deployed."
  type        = string
  default     = "latest"
}

# ── Network ───────────────────────────────────────────────────────────────────
variable "vnet_cidr" {
  description = "Address space for the virtual network."
  type        = string
  default     = "10.0.0.0/16"
}

variable "aca_subnet_cidr" {
  description = "Subnet delegated to the Container Apps environment. Must be at least a /23 — the platform refuses anything smaller."
  type        = string
  default     = "10.0.0.0/23"
}
{{#if withPostgres}}

variable "db_subnet_cidr" {
  description = "Subnet delegated to the PostgreSQL Flexible Server (must not overlap the Container Apps subnet)."
  type        = string
  default     = "10.0.4.0/24"
}
{{/if}}

# ── Application sizing ────────────────────────────────────────────────────────
# Container Apps bills per vCPU-second and per GiB-second of *running* replicas,
# and the allowed cpu/memory pairs are fixed (0.25/0.5Gi, 0.5/1Gi, 0.75/1.5Gi,
# 1/2Gi, …). Scaling a service to zero makes it free when idle, at the cost of a
# cold start on the next request.

variable "frontend_cpu" {
  description = "vCPU per frontend replica."
  type        = number
  default     = 0.25
}

variable "frontend_memory" {
  description = "Memory per frontend replica (must pair with the CPU value)."
  type        = string
  default     = "0.5Gi"
}

variable "frontend_min_replicas" {
  description = "Minimum frontend replicas. 1 keeps the public URL warm; 0 is free when idle but adds a cold start."
  type        = number
  default     = 1
}

variable "frontend_max_replicas" {
  description = "Maximum frontend replicas."
  type        = number
  default     = 3
}

variable "backend_cpu" {
  description = "vCPU per backend replica."
  type        = number
  default     = 0.5
}

variable "backend_memory" {
  description = "Memory per backend replica (must pair with the CPU value)."
  type        = string
  default     = "1Gi"
}

variable "backend_min_replicas" {
  description = "Minimum backend replicas."
  type        = number
  default     = 1
}

variable "backend_max_replicas" {
  description = "Maximum backend replicas."
  type        = number
  default     = 3
}
{{#if withCelery}}

variable "worker_cpu" {
  description = "vCPU per Celery worker replica."
  type        = number
  default     = 0.5
}

variable "worker_memory" {
  description = "Memory per Celery worker replica."
  type        = string
  default     = "1Gi"
}

variable "worker_replicas" {
  description = "Celery worker replicas. Kept fixed rather than autoscaled: scaling on queue depth needs a KEDA scale rule tuned to your workload."
  type        = number
  default     = 1
}
{{/if}}
{{#if withRedis}}

variable "redis_image" {
  description = "Redis image used as the Celery broker and result backend."
  type        = string
  default     = "docker.io/library/redis:7-alpine"
}
{{/if}}

variable "log_retention_days" {
  description = "Days of container logs to retain in Log Analytics."
  type        = number
  default     = 30
}

variable "debug" {
  description = "Value of the backend DEBUG setting."
  type        = string
  default     = "false"
}
{{#if withPostgres}}

# ── Azure Database for PostgreSQL (Flexible Server) ───────────────────────────
variable "db_version" {
  description = "PostgreSQL major version."
  type        = string
  default     = "16"
}

variable "db_sku_name" {
  description = "Flexible Server SKU (e.g. B_Standard_B1ms for dev, GP_Standard_D2ds_v4 for prod)."
  type        = string
  default     = "B_Standard_B1ms"
}

variable "db_storage_mb" {
  description = "Allocated storage in MB (minimum 32768)."
  type        = number
  default     = 32768
}

variable "db_name" {
  description = "Initial database name."
  type        = string
  default     = "app"
}

variable "db_username" {
  description = "Administrator username. The password is generated by Terraform and surfaced through the sensitive `database_url` output."
  type        = string
  default     = "appadmin"
}

variable "db_backup_retention_days" {
  description = "Days of automated backups to retain (7–35)."
  type        = number
  default     = 7
}

variable "db_high_availability" {
  description = "Run the database zone-redundant (recommended for prod; not available on Burstable SKUs)."
  type        = bool
  default     = false
}
{{/if}}
