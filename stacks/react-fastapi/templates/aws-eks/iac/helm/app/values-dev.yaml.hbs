## dev environment overrides — applied by `dude iac ship`/`deploy` on top of values.yaml.
##
## ⚠️  This file is GITIGNORED (see iac/.gitignore): it's the right place for both
## per-env tuning AND secrets (API keys, …), which must never be committed.
## `dude iac new-env --from dev` copies this to values-<env>.yaml for you — then
## scale the knobs up per environment.

backend:
  replicas: 1
  autoscaling:
    enabled: false

frontend:
  replicas: 1

config:
  DEBUG: "true"
  ## Add non-sensitive env vars here (key = ENV VAR NAME), e.g.:
  # LOG_LEVEL: "debug"

secrets: {}
  ## External/static secrets go here (key = ENV VAR NAME). They land in the
  ## Secret and are loaded into every app container via envFrom, e.g.:
  # STRIPE_API_KEY: "sk_live_…"
  ## DATABASE_URL is injected automatically from Terraform — do NOT set it here.

{{#if withCelery}}
celery:
  worker:
    replicas: 1
{{/if}}

ingress:
  enabled: true
  host: ""
