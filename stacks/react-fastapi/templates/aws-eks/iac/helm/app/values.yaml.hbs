## Default values for the {{projectName}} chart.
## Per-environment overrides live in values-<env>.yaml.

nameOverride: ""
fullnameOverride: ""

image:
  ## ECR registry host, e.g. 123456789012.dkr.ecr.eu-west-1.amazonaws.com
  ## Get it from `dude iac output` (ecr_*_repository_url) — the host part.
  registry: ""
  pullPolicy: IfNotPresent
  backend:
    repository: {{projectName}}-backend
    tag: latest
  frontend:
    repository: {{projectName}}-frontend
    tag: latest

backend:
  replicas: 2
  port: 8000
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      cpu: 500m
      memory: 512Mi
  autoscaling:
    enabled: false
    minReplicas: 2
    maxReplicas: 5
    targetCPUUtilizationPercentage: 70

frontend:
  replicas: 2
  ## nginx serving the production build (see frontend/Dockerfile.prod)
  port: 80
  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      cpu: 200m
      memory: 128Mi

## Non-sensitive configuration → rendered into a ConfigMap.
config:
  appTitle: {{projectName}}
  debug: "false"

## Sensitive configuration → rendered into a Secret.
## In CI, override via --set or a values file sourced from Secrets Manager.
secrets:
  ## postgresql://<user>:<password>@<rds-endpoint>:5432/<db>
  ## RDS endpoint: `dude iac output rds_endpoint`
  ## Password: AWS Secrets Manager (see rds_master_user_secret_arn).
  databaseUrl: ""

## PostgreSQL is provided by managed AWS RDS (provisioned by Terraform), not by
## the chart. `enabled` only controls whether the app wires DATABASE_URL and runs
## the migration job.
database:
  enabled: {{withPostgres}}
  ## Run `alembic upgrade head` as a pre-install/pre-upgrade hook job.
  runMigrations: {{withPostgres}}

## Redis runs in-cluster (broker/result backend for Celery).
redis:
  enabled: {{withRedis}}
  image: redis:7-alpine
  port: 6379
  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      cpu: 200m
      memory: 256Mi

celery:
  enabled: {{withCelery}}
  worker:
    replicas: 1
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 500m
        memory: 512Mi
  flower:
    enabled: {{withCelery}}
    port: 5555

celeryBeat:
  enabled: {{withCeleryBeat}}
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 200m
      memory: 256Mi

ingress:
  enabled: true
  className: alb
  ## Optional hostname. Empty → reach the app via the ALB's own DNS name.
  host: ""
  annotations:
    alb.ingress.kubernetes.io/scheme: internet-facing
    alb.ingress.kubernetes.io/target-type: ip
    alb.ingress.kubernetes.io/listen-ports: '[{"HTTP":80}]'
    alb.ingress.kubernetes.io/healthcheck-path: /api/health
  ## For TLS: request an ACM cert, then set certificateArn and switch listen-ports
  ## to include {"HTTPS":443}.
  certificateArn: ""

serviceAccount:
  create: true
  name: ""
  annotations: {}
