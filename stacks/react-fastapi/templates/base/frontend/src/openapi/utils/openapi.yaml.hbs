openapi: 3.1.0
info:
  title: {{projectName}} API
  version: 1.0.0
paths:
  /api/health:
    get:
      tags:
        - Health
      summary: Check service health
      description: 'Returns `{"status": "ok"}` while the process is accepting requests.'
      operationId: get_health_api_health_get
      responses:
        "200":
          description: Successful Response
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/HealthResponse"
components:
  schemas:
    HealthResponse:
      properties:
        status:
          type: string
          title: Status
      type: object
      required:
        - status
      title: HealthResponse
