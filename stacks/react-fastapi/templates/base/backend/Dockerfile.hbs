FROM python:3.13-slim
WORKDIR /app

# Install uv (fast Python package manager)
RUN pip install --no-cache-dir uv

# Install all dependencies (including dev: pytest, ruff, mypy …)
COPY pyproject.toml .
RUN uv sync --no-cache
{{#if withPostgres}}

# Copy start script (waits for Postgres, runs migrations, starts uvicorn)
COPY start.sh /start.sh
RUN chmod +x /start.sh
{{/if}}

# Create non-root user for security
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app{{#if withPostgres}} && chown appuser:appuser /start.sh{{/if}}
USER appuser
{{#if withPostgres}}

EXPOSE 8000
CMD ["/start.sh"]
{{else}}

EXPOSE 8000
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
{{/if}}
