"""FastAPI entrypoint."""

from fastapi import APIRouter, FastAPI
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import HTMLResponse

from app.core.api_docs import API_DESCRIPTION, API_TAGS, scalar_html
from app.core.config import settings
from app.routers import (
    health,
{{#if withPostgres}}
    users,
    users__id,
{{/if}}
)

# Serve the docs + OpenAPI schema under /api so they reach the backend through
# the ALB Ingress (which routes /api → backend, everything else → frontend). This
# keeps a single backend prefix and works identically in local dev (the Vite
# proxy forwards /api) and in the cluster.
#
# The built-in Swagger UI and ReDoc are off: /api/docs is the one reference, and
# it renders the narrative from app/core/api_docs.py.
app = FastAPI(
    title="{{projectName}} API",
    description=API_DESCRIPTION,
    version="1.0.0",
    openapi_tags=API_TAGS,
    # Add deployed environments here so the reference's "Test Request" panel can
    # target them.
    servers=[{"url": "http://localhost:8000", "description": "Local development"}],
    docs_url=None,
    redoc_url=None,
    openapi_url="/api/openapi.json",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:5173"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


@app.get("/api/docs", include_in_schema=False)
async def get_api_docs() -> HTMLResponse:
    """Serve the API reference (Scalar)."""
    return HTMLResponse(scalar_html(settings.APP_TITLE, "/api/openapi.json"))


api_router = APIRouter(prefix="/api")

api_router.include_router(health.router)
{{#if withPostgres}}
api_router.include_router(users.router)
api_router.include_router(users__id.router)
{{/if}}

app.include_router(api_router)
