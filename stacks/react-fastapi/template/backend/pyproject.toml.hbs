[project]
name = "{{projectName}}-backend"
version = "0.0.1"
description = "FastAPI backend for {{projectName}}"
requires-python = ">=3.13"
dependencies = [
    "fastapi>=0.115.0",
    "pydantic-settings>=2.6.0",
    "uvicorn[standard]>=0.32.0",
{{#if withPostgres}}
    "alembic>=1.14.0",
    "psycopg2-binary>=2.9.9",
    "sqlmodel>=0.0.22",
{{/if}}
{{#if withCelery}}
    "celery[redis]>=5.4.0",
{{/if}}
]

[tool.uv]
dev-dependencies = [
    "pytest>=8.0.0",
    "pytest-asyncio>=0.24.0",
    "httpx>=0.27.0",
    "ruff>=0.7.0",
    "mypy>=1.13.0",
]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "N", "UP", "B", "S", "RUF"]

[tool.mypy]
strict = true
