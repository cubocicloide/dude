{
  "name": "{{projectName}}-e2e",
  "version": "0.0.1",
  "private": true,
  "description": "End-to-end tests — Playwright + Cucumber.js (BDD/Gherkin)",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "HEADED=true cucumber-js",
    "test:report": "cucumber-js --format html:reports/cucumber.html --format json:reports/cucumber.json",
    "install:browsers": "playwright install --with-deps chromium",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write '**/*.{ts,json}' --ignore-path .prettierignore",
    "format:check": "prettier --check '**/*.{ts,json}' --ignore-path .prettierignore"
  },
  "dependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.50.0",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
