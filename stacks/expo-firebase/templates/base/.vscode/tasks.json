{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dude lint (watch)",
      "type": "shell",
      "command": "echo 'Lint started'; dude lint 2>&1; fswatch -r --exclude '\\.git' --exclude 'node_modules' --exclude '__pycache__' --exclude '\\.venv' --exclude '\\.mypy_cache' . | while read -r _; do echo 'Lint started'; dude lint 2>&1; done",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": {
        "owner": "dude",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Lint started$",
          "endsPattern": "^(No issues found\\.|(\\d+ errors?(, \\d+ warnings?)?|\\d+ warnings?))$"
        },
        "pattern": {
          "regexp": "^(.+?)\\((\\d+),(\\d+)\\):\\s+(error|warning)\\s+([\\w-]+):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    }
  ]
}
