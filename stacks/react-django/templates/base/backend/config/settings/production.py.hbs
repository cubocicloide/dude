"""Production settings — everything security-sensitive comes from the environment.

Required environment variables:
  DJANGO_SECRET_KEY            — no fallback, the process refuses to start without it
  DJANGO_ALLOWED_HOSTS         — comma-separated, e.g. "api.example.com"
  DATABASE_URL                 — e.g. postgres://user:pass@host:5432/dbname

Optional:
  DJANGO_CSRF_TRUSTED_ORIGINS  — comma-separated origins, e.g. "https://app.example.com"
  DJANGO_CORS_ALLOWED_ORIGINS  — comma-separated origins allowed to call the API
"""

from .base import *  # noqa: F401,F403
from .base import STORAGES, env

SECRET_KEY = env("DJANGO_SECRET_KEY")

DEBUG = False

ALLOWED_HOSTS = env.list("DJANGO_ALLOWED_HOSTS")

CSRF_TRUSTED_ORIGINS = env.list("DJANGO_CSRF_TRUSTED_ORIGINS", default=[])

CORS_ALLOWED_ORIGINS = env.list("DJANGO_CORS_ALLOWED_ORIGINS", default=[])

# Behind a TLS-terminating load balancer / reverse proxy.
SECURE_PROXY_SSL_HEADER = ("HTTP_X_FORWARDED_PROTO", "https")
SESSION_COOKIE_SECURE = True
CSRF_COOKIE_SECURE = True

# The database must be explicitly configured in production — no SQLite fallback.
DATABASES = {"default": env.db("DATABASE_URL")}

# Whitenoise serves collected static files (run `manage.py collectstatic`).
STORAGES["staticfiles"] = {
    "BACKEND": "whitenoise.storage.CompressedManifestStaticFilesStorage",
}
