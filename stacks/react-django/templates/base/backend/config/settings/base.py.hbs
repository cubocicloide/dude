"""Base Django settings shared by every environment.

Environment-specific settings live in ``local.py`` (development) and
``production.py`` (deployed). Pick one with ``DJANGO_SETTINGS_MODULE``
(default: ``config.settings.local``).

Note: ``SECRET_KEY`` and ``DEBUG`` are intentionally **not** defined here —
``local.py`` provides safe development values, ``production.py`` requires them
from the environment.
"""

from pathlib import Path

import environ

env = environ.Env()

# backend/ directory (contains manage.py) — /app inside the container
BASE_DIR = Path(__file__).resolve().parent.parent.parent

# ── Application definition ────────────────────────────────────────────────────

# django-unfold — the admin theme. Every entry MUST precede
# "django.contrib.admin": Unfold works by overriding the admin's templates, and
# Django resolves templates in INSTALLED_APPS order, so listing it later silently
# gives you the stock admin back.
#
# The three contrib modules below pull in no extra packages. The remaining ones
# each need their own dependency, so add both together if you want them:
# unfold.contrib.import_export (django-import-export),
# unfold.contrib.guardian (django-guardian),
# unfold.contrib.simple_history (django-simple-history).
ADMIN_APPS = [
    "unfold",
    "unfold.contrib.filters",
    "unfold.contrib.forms",
    "unfold.contrib.inlines",
]

DJANGO_APPS = [
    "django.contrib.admin",
    "django.contrib.auth",
    "django.contrib.contenttypes",
    "django.contrib.sessions",
    "django.contrib.messages",
    "django.contrib.staticfiles",
]

THIRD_PARTY_APPS = [
    "rest_framework",
    "drf_spectacular",
    "corsheaders",
{{#if withS3}}
    "storages",
{{/if}}
]

LOCAL_APPS = [
    "apps.core",
    "apps.users",
{{#if withS3}}
    "apps.files",
{{/if}}
]

INSTALLED_APPS = ADMIN_APPS + DJANGO_APPS + THIRD_PARTY_APPS + LOCAL_APPS

MIDDLEWARE = [
    "django.middleware.security.SecurityMiddleware",
    "whitenoise.middleware.WhiteNoiseMiddleware",
    "django.contrib.sessions.middleware.SessionMiddleware",
    "corsheaders.middleware.CorsMiddleware",
    "django.middleware.common.CommonMiddleware",
    "django.middleware.csrf.CsrfViewMiddleware",
    "django.contrib.auth.middleware.AuthenticationMiddleware",
    "django.contrib.messages.middleware.MessageMiddleware",
    "django.middleware.clickjacking.XFrameOptionsMiddleware",
]

ROOT_URLCONF = "config.urls"

TEMPLATES = [
    {
        "BACKEND": "django.template.backends.django.DjangoTemplates",
        "DIRS": [],
        "APP_DIRS": True,
        "OPTIONS": {
            "context_processors": [
                "django.template.context_processors.debug",
                "django.template.context_processors.request",
                "django.contrib.auth.context_processors.auth",
                "django.contrib.messages.context_processors.messages",
            ],
        },
    },
]

WSGI_APPLICATION = "config.wsgi.application"

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite by default; set DATABASE_URL (e.g. postgres://…) to override.

DATABASES = {"default": env.db("DATABASE_URL", default=f"sqlite:///{BASE_DIR / 'db.sqlite3'}")}

DEFAULT_AUTO_FIELD = "django.db.models.BigAutoField"

# ── Authentication ────────────────────────────────────────────────────────────

AUTH_USER_MODEL = "users.User"

AUTH_PASSWORD_VALIDATORS = [
    {"NAME": "django.contrib.auth.password_validation.UserAttributeSimilarityValidator"},
    {"NAME": "django.contrib.auth.password_validation.MinimumLengthValidator"},
    {"NAME": "django.contrib.auth.password_validation.CommonPasswordValidator"},
    {"NAME": "django.contrib.auth.password_validation.NumericPasswordValidator"},
]

# ── Internationalisation ──────────────────────────────────────────────────────

LANGUAGE_CODE = "en-us"
TIME_ZONE = "UTC"
USE_I18N = True
USE_TZ = True

# ── Static & media files ──────────────────────────────────────────────────────
# STATIC_URL is namespaced so an edge router (e.g. an ALB) can path-route
# /django-static/* to the backend without colliding with the frontend assets.

STATIC_URL = "/django-static/"
STATIC_ROOT = BASE_DIR / "staticfiles"

MEDIA_URL = "/media/"
MEDIA_ROOT = BASE_DIR / "media"

STORAGES = {
{{#if withS3}}
    # Object storage — S3 in production, MinIO locally (AWS_S3_ENDPOINT_URL).
    "default": {
        "BACKEND": "storages.backends.s3.S3Storage",
    },
{{else}}
    "default": {
        "BACKEND": "django.core.files.storage.FileSystemStorage",
    },
{{/if}}
    # production.py switches this to whitenoise's compressed manifest storage.
    "staticfiles": {
        "BACKEND": "django.contrib.staticfiles.storage.StaticFilesStorage",
    },
}
{{#if withS3}}

# django-storages (S3) configuration — MinIO locally, real S3 in production
# (leave AWS_S3_ENDPOINT_URL unset outside local development).
AWS_ACCESS_KEY_ID = env("AWS_ACCESS_KEY_ID", default=None)
AWS_SECRET_ACCESS_KEY = env("AWS_SECRET_ACCESS_KEY", default=None)
AWS_STORAGE_BUCKET_NAME = env("AWS_STORAGE_BUCKET_NAME", default="{{projectName}}-media")
AWS_S3_ENDPOINT_URL = env("AWS_S3_ENDPOINT_URL", default="") or None
AWS_S3_REGION_NAME = env("AWS_S3_REGION_NAME", default=None)
AWS_S3_FILE_OVERWRITE = False
AWS_DEFAULT_ACL = None
AWS_QUERYSTRING_AUTH = True  # serve files via presigned URLs
{{/if}}

# ── Admin theme (django-unfold) ───────────────────────────────────────────────
# Needs no URL wiring — Unfold themes the stock admin site at /admin/ by
# overriding its templates. ModelAdmin classes must subclass
# `unfold.admin.ModelAdmin` to pick up the styling (see apps/users/admin.py).
#
# Full option list: https://unfoldadmin.com/docs/configuration/settings/
UNFOLD = {
    "SITE_TITLE": env("APP_TITLE", default="{{projectName}}") + " admin",
    "SITE_HEADER": env("APP_TITLE", default="{{projectName}}"),
    # Link the header back to the frontend.
    "SITE_URL": "/",
    "SHOW_HISTORY": True,
    "SHOW_VIEW_ON_SITE": True,
    "SIDEBAR": {
        "show_search": True,
        # No "navigation" key → Unfold renders the standard app/model list.
        # Add one to hand-order the sidebar as the project grows.
    },
    # To match the frontend's accent, add a "COLORS" ramp here — Unfold wants
    # space-separated RGB channels per Tailwind shade, e.g.
    # "COLORS": {"primary": {"500": "22 119 255", …}}. Omitted so the scaffold
    # ships Unfold's own tested palette rather than a half-filled one.
}

# ── Django REST Framework ─────────────────────────────────────────────────────

REST_FRAMEWORK = {
    "DEFAULT_SCHEMA_CLASS": "drf_spectacular.openapi.AutoSchema",
    "DEFAULT_PAGINATION_CLASS": "rest_framework.pagination.PageNumberPagination",
    "PAGE_SIZE": 50,
    # Secure by default — individual views opt out with an explicit
    # `permission_classes` declaration (required by lint rule BE003).
    "DEFAULT_PERMISSION_CLASSES": ["rest_framework.permissions.IsAuthenticated"],
}

SPECTACULAR_SETTINGS = {
    "TITLE": env("APP_TITLE", default="{{projectName}}") + " API",
    "VERSION": "1.0.0",
    "SERVE_INCLUDE_SCHEMA": False,
}
{{#if withCelery}}

# ── Celery ────────────────────────────────────────────────────────────────────
# Read by config/celery.py via the CELERY_ settings namespace.

CELERY_BROKER_URL = env("CELERY_BROKER_URL", default="redis://redis:6379/0")
CELERY_RESULT_BACKEND = env("CELERY_RESULT_BACKEND", default="redis://redis:6379/0")
CELERY_TASK_ALWAYS_EAGER = False  # tests flip this on via a fixture / settings override
{{/if}}

# ── Logging ───────────────────────────────────────────────────────────────────
# Console logging only — containers forward stdout/stderr. Use
# `logging.getLogger(__name__)` in application code (never `print`, BE012).

LOGGING = {
    "version": 1,
    "disable_existing_loggers": False,
    "formatters": {
        "verbose": {
            "format": "{levelname} {asctime} {name} {message}",
            "style": "{",
        },
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "formatter": "verbose",
        },
    },
    "root": {
        "handlers": ["console"],
        "level": "INFO",
    },
}
