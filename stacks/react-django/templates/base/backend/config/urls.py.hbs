"""Root URL configuration for {{projectName}}.

Every API app is mounted under the ``api/`` prefix (lint rule BE008); each app
declares its own routes (and an ``app_name``) in ``apps/<app>/urls.py``.
"""

from django.contrib import admin
from django.urls import include, path
from django.views.generic import TemplateView
from drf_spectacular.views import SpectacularAPIView

urlpatterns = [
    path("admin/", admin.site.urls),
    # API apps
    path("api/", include("apps.core.urls")),
    path("api/", include("apps.users.urls")),
{{#if withS3}}
    path("api/", include("apps.files.urls")),
{{/if}}
    # OpenAPI schema (drf-spectacular) + the reference page (Scalar, rendered from
    # backend/templates/api-docs.html). One docs URL — no Swagger UI, no ReDoc.
    path("api/schema/", SpectacularAPIView.as_view(), name="schema"),
    path("api/docs/", TemplateView.as_view(template_name="api-docs.html"), name="docs"),
]
