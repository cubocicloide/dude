[project]
name = "{{projectName}}-backend"
version = "0.0.1"
description = "Django REST Framework backend for {{projectName}}"
requires-python = ">=3.13"
dependencies = [
    "django>=5.1,<6.0",
    "djangorestframework>=3.15.0",
    "drf-spectacular>=0.28.0",
    "django-environ>=0.11.0",
    "django-cors-headers>=4.6.0",
    "django-unfold>=0.102.0",
    "whitenoise>=6.8.0",
    "gunicorn>=23.0.0",
{{#if withPostgres}}
    "psycopg[binary]>=3.2.0",
{{/if}}
{{#if withS3}}
    "django-storages[boto3]>=1.14.0",
{{/if}}
{{#if withCelery}}
    "celery[redis]>=5.4.0",
{{/if}}
]

[dependency-groups]
dev = [
    "pytest>=8.0.0",
    "pytest-django>=4.9.0",
    "ruff>=0.7.0",
]

[tool.pytest.ini_options]
DJANGO_SETTINGS_MODULE = "config.settings.local"
testpaths = ["apps"]
python_files = ["test_*.py"]

[tool.ruff]
line-length = 100
target-version = "py313"

[tool.ruff.lint]
select = ["E", "F", "I", "N", "UP", "B", "S", "RUF"]

[tool.ruff.lint.per-file-ignores]
# Markdown narrative + tag prose — line length is not a useful rule there.
"config/api_docs.py" = ["E501"]
# Tests use asserts (S101) and throw-away credentials (S105/S106).
"apps/*/tests/*" = ["S101", "S105", "S106"]
# Hand-written / autogenerated migrations may exceed the line length.
"apps/*/migrations/*" = ["E501"]
