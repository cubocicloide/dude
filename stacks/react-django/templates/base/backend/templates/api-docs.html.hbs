<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{projectName}} API reference</title>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Crect width='48' height='48' rx='12' fill='%231677ff'/%3E%3C/svg%3E"
    />
    <style>
      html,
      body {
        margin: 0;
      }
      :root {
        --scalar-font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue',
          Arial, sans-serif;
        --scalar-font-code: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      /* Brand accent — matches the frontend's antd primary colour. */
      .light-mode {
        --scalar-color-accent: #1677ff;
      }
      .dark-mode {
        --scalar-color-accent: #4096ff;
      }

      /* Brand bar. Delete this block and the <header> below together if you'd
         rather have Scalar's own header on its own. */
      .brandbar {
        position: sticky;
        top: 0;
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        height: 56px;
        padding: 0 1.25rem;
        background: #1677ff;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.18);
      }
      .brandbar .name {
        color: #fff;
        font: 600 1rem/1 system-ui, -apple-system, sans-serif;
      }
      .brandbar .spacer {
        flex: 1;
      }
      .brandbar .tag {
        color: #fff;
        opacity: 0.92;
        font: 600 0.78rem/1 system-ui, -apple-system, sans-serif;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <header class="brandbar">
      <span class="name">{{projectName}}</span>
      <span class="spacer"></span>
      <span class="tag">API reference</span>
    </header>
    <div id="app"></div>
    <script src="https://cdn.jsdelivr.net/npm/@scalar/api-reference"></script>
    <script>
      Scalar.createApiReference('#app', {
        url: "{% url 'schema' %}",
        theme: 'default',
        layout: 'modern',
        hideDownloadButton: true,
        showDeveloperTools: 'never',
        persistAuth: true,
        withDefaultFonts: false,
        metaData: {
          title: '{{projectName}} API reference',
          description: 'HTTP API reference for {{projectName}}.',
        },
        // Preselect a scheme so the Authentication panel opens with a filled
        // field instead of "No authentication selected". Change this key when you
        // swap the authenticators — it must match one of the keys drf-spectacular
        // emits under components.securitySchemes (basicAuth, cookieAuth, jwtAuth…).
        authentication: {
          preferredSecurityScheme: 'basicAuth',
        },
        customCss: `
          :root {
            /* Room for the brand bar so Scalar still fits the viewport. Drop
               this line together with the <header> if you remove the bar. */
            --scalar-custom-header-height: 56px;
          }
          a[href*="scalar.com"] { display: none !important; }
        `,
      })
    </script>
  </body>
</html>
