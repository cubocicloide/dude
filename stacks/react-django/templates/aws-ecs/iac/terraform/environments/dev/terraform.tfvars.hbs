# dev environment — small, cost-conscious defaults.
# Copy this folder to add a new environment (e.g. environments/prod) and bump
# the sizing / durability knobs there.

environment = "dev"
region      = "eu-west-1"

# The image tag currently deployed (backend + frontend are built and pushed
# together under the same tag). `dude iac deploy` (and `ship`) rewrite this
# line, so a plain `dude iac apply` always re-deploys the same build.
image_tag = "latest"

# Fargate sizing.
backend_cpu     = 512
backend_memory  = 1024
frontend_cpu    = 256
frontend_memory = 512

backend_desired_count  = 1
frontend_desired_count = 1
{{#if withCelery}}

# Celery worker sizing.
worker_cpu           = 512
worker_memory        = 1024
worker_desired_count = 1
{{/if}}

# Database. Production parity: this environment always runs RDS PostgreSQL,
# even when local development was scaffolded on SQLite.
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20

# Who may reach the app. Consider restricting to your org's networks for
# non-production environments.
allowed_cidrs = ["0.0.0.0/0"]

# TLS + DNS (optional) — uncomment and set to serve HTTPS on your own domain.
# The hosted zone must already exist in Route53. Terraform then issues an ACM
# certificate (DNS-validated), points the domain at the ALB, and the ALB
# listens on 443 redirecting HTTP→HTTPS. Leave commented for plain HTTP.
# domain_name       = "app.example.com"
# route53_zone_name = "example.com"
