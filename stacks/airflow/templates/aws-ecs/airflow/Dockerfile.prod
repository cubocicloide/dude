# Production image — same base as the dev image, but DAGs, plugins and the
# sign-on config are BAKED IN: a deploy is an immutable image roll, there is
# no live mount in AWS. Built by `dude iac build` / `ship` with this file.
ARG AIRFLOW_VERSION=3.1.0
FROM apache/airflow:${AIRFLOW_VERSION}

# Project packages — pinned in requirements.txt (lint rule AF009).
COPY requirements.txt /requirements.txt
RUN pip install --no-cache-dir -r /requirements.txt

# The code IS the artifact: dags, plugins and the FAB auth config.
COPY config/webserver_config.py /opt/airflow/webserver_config.py
COPY dags/ /opt/airflow/dags/
COPY plugins/ /opt/airflow/plugins/
