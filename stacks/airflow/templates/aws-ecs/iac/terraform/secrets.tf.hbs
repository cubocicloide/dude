# Secrets — two Secrets Manager secrets per environment:
#
#   core  (<project>/<env>/core)  owned by Terraform: DB connection URI,
#         Fernet key, inter-component JWT secret{{#unless withEntraId}}, bootstrap admin password{{/unless}}.
#   app   (<project>/<env>/app)   owned by YOU, via `dude iac secrets`:
#         a JSON object of KEY=VALUE pairs. Every key listed in
#         `app_secret_keys` (terraform.tfvars) is injected into all Airflow
#         containers as an environment variable of the same name.

# Fernet key: 32 random bytes, urlsafe-base64. random_id.b64_url emits 43
# chars without padding; the trailing "=" makes it the valid 44-char form
# cryptography's Fernet expects.
resource "random_id" "fernet" {
  byte_length = 32
}

resource "random_password" "jwt" {
  length  = 64
  special = false
}
{{#unless withEntraId}}

resource "random_password" "admin" {
  length  = 20
  special = false
}
{{/unless}}

resource "aws_secretsmanager_secret" "core" {
  name                    = "${var.project_name}/${var.environment}/core"
  recovery_window_in_days = 0 # allow re-create in dev teardown loops
}

resource "aws_secretsmanager_secret_version" "core" {
  secret_id = aws_secretsmanager_secret.core.id
  secret_string = jsonencode({
    sql_alchemy_conn = "postgresql+psycopg2://${aws_db_instance.this.username}:${random_password.db.result}@${aws_db_instance.this.address}:5432/${aws_db_instance.this.db_name}"
    fernet_key       = "${random_id.fernet.b64_url}="
    jwt_secret       = random_password.jwt.result
{{#unless withEntraId}}
    admin_password   = random_password.admin.result
{{/unless}}
  })
}

resource "aws_secretsmanager_secret" "app" {
  name                    = "${var.project_name}/${var.environment}/app"
  recovery_window_in_days = 0
}

# Seeded empty; after that `dude iac secrets --set KEY=VALUE` owns the value —
# ignore_changes stops Terraform from wiping it back to {} on every apply.
resource "aws_secretsmanager_secret_version" "app" {
  secret_id     = aws_secretsmanager_secret.app.id
  secret_string = jsonencode({})

  lifecycle {
    ignore_changes = [secret_string]
  }
}

# ── Task logs bucket ─────────────────────────────────────────────────────────
# Executor workers are ephemeral containers: task logs must go somewhere that
# outlives them. Airflow's S3 remote logging writes here; the api-server reads
# logs back from here into the UI.

resource "aws_s3_bucket" "logs" {
  bucket        = "${local.name}-airflow-logs-${data.aws_caller_identity.current.account_id}"
  force_destroy = true
}

resource "aws_s3_bucket_public_access_block" "logs" {
  bucket                  = aws_s3_bucket.logs.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_lifecycle_configuration" "logs" {
  bucket = aws_s3_bucket.logs.id

  rule {
    id     = "expire-task-logs"
    status = "Enabled"

    filter {
      prefix = "task-logs/"
    }

    expiration {
      days = var.log_retention_days
    }
  }
}
